# 1) Telegram bot token from @BotFather (a NEW bot for LeadCatcher)
BOT_TOKEN=

# 2) Sales team. ADMIN_IDS: Telegram ids (send /chatid to the bot to see yours), several: 111,222
ADMIN_IDS=
#    Optional: a sales GROUP. Add the bot to the group, send /chatid there, paste the number (starts with -).
#    Set = leads go to the group and every member can take them. Empty = leads go to each admin in private.
LEADS_CHAT_ID=

# true = demo: visitors also get a copy of the sales card and can try /stats /leads /export with their own leads
DEMO_MODE=true
TIMEZONE=Europe/Tallinn

# Questions, answers, scores and texts
FUNNEL_FILE=funnel.json
# Remind people who stopped half-way (minutes). 0 = off
NUDGE_AFTER_MIN=60

# Send every lead to Google Sheets / Zapier / Make / n8n / a CRM. Several: url1,url2
# Google Sheets: see integrations/google_sheets.gs
WEBHOOK_URLS=
# Optional: signs each webhook body, header X-Signature: sha256=<HMAC>
WEBHOOK_SECRET=

# Website forms (POST /api/leads). Sites allowed to send forms, e.g. https://smile-dental.ee,https://www.smile-dental.ee
# * = any site
ALLOWED_ORIGINS=*
# true when the bot is behind Caddy / nginx (on the server)
TRUST_PROXY=false
HOST=0.0.0.0
PORT=8080

DATABASE_URL=sqlite+aiosqlite:///leads.db
